# 이 파일을 ".env" 라는 이름으로 복사해서 사용하세요.  (cp .env.example .env)
# ".env" 는 .gitignore 에 들어 있어서 GitHub 에 올라가지 않습니다. 절대 남에게 보여주지 마세요.

# ── 실전 매매(--live)에만 필요 ─────────────────────────────
# 거래소에서 API 키를 발급할 때 반드시:
#   1) "자산조회 + 주문" 권한만 체크  (출금 권한은 절대 체크하지 마세요)
#   2) 허용 IP 를 봇이 돌아가는 컴퓨터의 IP 로 제한
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# ── 텔레그램 알림 (선택) ───────────────────────────────────
# 비워두면 알림 없이 화면/로그에만 기록됩니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
